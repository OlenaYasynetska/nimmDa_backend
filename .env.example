# Copy to .env locally. Do not commit secrets.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=nimmda
MYSQL_USER=root
MYSQL_PASSWORD=root

MONGODB_URI=mongodb://127.0.0.1:27017/nimmda
MONGO_PORT=27017
MONGO_DB=nimmda

# PORT=8080
# FRONTEND_BASE_URL=http://localhost:4200
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# JWT_SECRET=change-me
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# Railway production:
# FRONTEND_BASE_URL=https://www.nimmda.org
# CORS_ALLOWED_ORIGINS=https://www.nimmda.org,https://nimmda.org
# JWT_SECRET=<long-random-string>
# SUPER_ADMIN_EMAIL=superadmin@nimmda.local
# SUPER_ADMIN_PASSWORD=<secret-not-in-git>

# Transactional mail for the marketplace: Resend (HTTPS), not Gmail SMTP.
# 1. Create a key at https://resend.com/api-keys
# 2. Verify domain nimmda.org at https://resend.com/domains (Cloudflare DNS)
# 3. Set on Railway nimmDa_backend:
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=NimmDa <noreply@nimmda.org>
# FRONTEND_BASE_URL=https://www.nimmda.org
